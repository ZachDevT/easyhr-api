EASYHR_ENV=development
EASYHR_HTTP_ADDRESS=:8080
EASYHR_DATABASE_URL=postgres://easyhr:easyhr@localhost:5432/easyhr?sslmode=disable
EASYHR_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:3001
EASYHR_CLERK_SECRET_KEY=
EASYHR_CLERK_ISSUER=https://your-instance.clerk.accounts.dev
EASYHR_CLERK_AUTHORIZED_PARTIES=http://localhost:3000,http://localhost:3001
# Optional: require a JWT template audience. Leave blank only when the configured Clerk session token has no audience claim.
EASYHR_CLERK_AUDIENCES=
# S3-compatible private document storage. These local defaults work with the
# MinIO service in docker-compose; use IAM or workload credentials in production.
EASYHR_DOCUMENTS_S3_BUCKET=easyhr-documents
EASYHR_DOCUMENTS_S3_REGION=us-east-1
EASYHR_DOCUMENTS_S3_ENDPOINT=http://localhost:9000
EASYHR_DOCUMENTS_S3_ACCESS_KEY_ID=easyhr-minio
EASYHR_DOCUMENTS_S3_SECRET_ACCESS_KEY=replace-with-a-local-dev-secret
EASYHR_DOCUMENTS_S3_USE_PATH_STYLE=true
